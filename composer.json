{
    "name": "local/gestion-vaccination",
    "description": "Permanent isolated automated test suite for the gestion_vaccination procedural PHP application.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/runner.php all",
        "test:unit": "@php tests/runner.php unit",
        "test:integration": "@php tests/runner.php integration",
        "test:http": "@php tests/runner.php http",
        "test:security": "@php tests/runner.php security"
    },
    "config": {
        "sort-packages": true
    }
}
